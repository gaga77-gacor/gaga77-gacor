          baseUrl:
            cfg.baseUrl || "",

          apiKeyConfigured:
            Boolean(key),

          apiKeyMasked:
            key
              ? (
                  key.length <= 8
                    ? "********"
                    : key.slice(0, 4) +
                      "********" +
                      key.slice(-4)
                )
              : ""
        });
      }


      /* SAVE GATEWAY CONFIG */

      if (
        path ===
          "/admin/gateway/config" &&
        request.method === "POST"
      ) {

        if (
          !isAdmin(
            request,
            env
          )
        ) {
          return json(
            {
              success: false,
              message:
                "Admin tidak diizinkan."
            },
            401
          );
        }

        const body =
          await readJson(
            request
          );

        const apiKey =
          safeString(
            body.apiKey
          );

        const baseUrl =
          safeString(
            body.baseUrl ||
              "https://instanpay.net"
          ).replace(
            /\/+$/,
            ""
          );

        if (
          !apiKey ||
          !baseUrl
        ) {
          return json(
            {
              success: false,
              message:
                "API Key dan Base URL wajib diisi."
            },
            400
          );
        }

        let parsed;

        try {
          parsed =
            new URL(baseUrl);
        } catch {
          return json(
            {
              success: false,
              message:
                "Base URL tidak valid."
            },
            400
          );
        }

        if (
          !/^https?:$/.test(
            parsed.protocol
          )
        ) {
          return json(
            {
              success: false,
              message:
                "Base URL harus HTTP/HTTPS."
            },
            400
          );
        }

        if (
          parsed.hostname !==
          "instanpay.net"
        ) {
          return json(
            {
              success: false,
              message:
                "Base URL Instanpay harus https://instanpay.net"
            },
            400
          );
        }

        await env.DB.prepare(`
          INSERT INTO gateway_config(
            id,
            api_key,
            base_url,
            updated_at
          )
          VALUES(
            1,
            ?,
            ?,
            ?
          )
          ON CONFLICT(id)
          DO UPDATE SET
            api_key=excluded.api_key,
            base_url=excluded.base_url,
            updated_at=excluded.updated_at
        `)
          .bind(
            apiKey,
            baseUrl,
            new Date().toISOString()
          )
          .run();

        return json({
          success: true,

          message:
            "Konfigurasi gateway berhasil disimpan.",

          baseUrl,

          apiKeyMasked:
            apiKey.length <= 8
              ? "********"
              : apiKey.slice(0, 4) +
                "********" +
                apiKey.slice(-4)
        });
      }


      /* =====================================================
         REGISTER
      ===================================================== */

      if (
        path === "/register" &&
        request.method === "POST"
      ) {

        const body =
          await readJson(
            request
