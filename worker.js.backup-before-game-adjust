      /* GET GATEWAY CONFIG */

      if (
        path ===
          "/admin/gateway/config" &&
        request.method === "GET"
      ) {

        if (
          !isAdmin(
            request,
            env
          )
        ) {
          return json(
            {
              success: false,
              message:
                "Admin tidak diizinkan."
            },
