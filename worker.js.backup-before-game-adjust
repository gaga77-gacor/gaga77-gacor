              ?,
              ?,
              ?,
              ?,
              ?,
              ?,
              0
            )
          `)
            .bind(
              username,
              pd.salt +
                ":" +
                pd.hash,
              bank,
              namaRekening,
              nomorRekening,
              nomorHp
            )
            .run();

        const user =
          await env.DB.prepare(`
