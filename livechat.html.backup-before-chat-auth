<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#0c1729">

<title>Live Chat</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

html,
body{
    width:100%;
    height:100%;
}

body{
    min-height:100vh;
    background:
        radial-gradient(
            circle at 15% 10%,
            rgba(139,92,246,.18),
            transparent 32%
        ),
        radial-gradient(
            circle at 85% 90%,
            rgba(59,130,246,.13),
            transparent 32%
        ),
        linear-gradient(
            135deg,
            #050a14,
            #0b1424 55%,
            #101a2d
        );
    color:#fff;
    display:flex;
    justify-content:center;
    align-items:center;
}

/* =====================================================
   CHAT BOX
===================================================== */

.chatBox{
    width:100%;
    max-width:470px;
    height:720px;
    background:#0c1729;
    border:1px solid rgba(255,255,255,.08);
    border-radius:22px;
    overflow:hidden;
    box-shadow:
        0 25px 80px rgba(0,0,0,.55),
        0 0 45px rgba(139,92,246,.08);
    display:flex;
    flex-direction:column;
}

/* =====================================================
   HEADER
===================================================== */

.chatHeader{
    min-height:76px;
    padding:13px 16px;
    display:flex;
    align-items:center;
    gap:11px;
    background:rgba(20,32,54,.97);
    border-bottom:1px solid rgba(255,255,255,.07);
}

.backBtn{
    width:38px;
    height:38px;
    border:0;
    border-radius:12px;
    background:#172640;
    color:#fff;
    cursor:pointer;
    font-size:18px;
}

.backBtn:active{
    transform:scale(.96);
}

.avatarWrap{
    position:relative;
}

.avatar{
    width:45px;
    height:45px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:21px;
    background:
        linear-gradient(
            135deg,
            #8b5cf6,
            #6d28d9
        );
    box-shadow:
        0 5px 18px rgba(139,92,246,.3);
}

.avatarOnline{
    position:absolute;
    right:-1px;
    bottom:1px;
    width:11px;
    height:11px;
    border-radius:50%;
    background:#00e887;
    border:2px solid #142036;
    box-shadow:0 0 8px #00e887;
}

.headerInfo{
    flex:1;
    min-width:0;
}

.headerName{
    font-size:15px;
    font-weight:700;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.headerStatus{
    margin-top:4px;
    font-size:11px;
    color:#00e887;
}

.statusDot{
    display:inline-block;
    width:7px;
    height:7px;
    margin-right:4px;
    border-radius:50%;
    background:#00e887;
    box-shadow:0 0 7px #00e887;
}

.connection{
    font-size:10px;
    color:#78869a;
    white-space:nowrap;
}

/* =====================================================
   MESSAGES
===================================================== */

.messages{
    flex:1;
    min-height:0;
    overflow-y:auto;
    padding:18px 14px;
    display:flex;
    flex-direction:column;
    gap:10px;
    scroll-behavior:smooth;
}

.messages::-webkit-scrollbar{
    width:4px;
}

.messages::-webkit-scrollbar-thumb{
    background:#273854;
    border-radius:20px;
}

.message{
    max-width:82%;
    padding:11px 13px;
    border-radius:16px;
    font-size:13px;
    line-height:1.5;
    word-break:break-word;
    white-space:pre-wrap;
    box-shadow:
        0 4px 14px rgba(0,0,0,.15);
}

.message.user{
    align-self:flex-end;
    background:
        linear-gradient(
            135deg,
            #8b5cf6,
            #7042d7
        );
    border-bottom-right-radius:4px;
}

.message.admin{
    align-self:flex-start;
    background:#182943;
    border:1px solid rgba(255,255,255,.05);
    border-bottom-left-radius:4px;
}

.messageTime{
    display:block;
    margin-top:5px;
    font-size:9px;
    opacity:.62;
}

/* =====================================================
   EMPTY
===================================================== */

.empty{
    margin:auto;
    padding:25px;
    text-align:center;
    color:#6e7c91;
    font-size:12px;
    line-height:1.8;
}

.emptyIcon{
    font-size:32px;
    margin-bottom:8px;
}

/* =====================================================
   QUICK ACTION
===================================================== */

.quickArea{
    display:flex;
    gap:7px;
    padding:9px 10px;
    overflow-x:auto;
    background:#091426;
    border-top:1px solid rgba(255,255,255,.05);
}

.quickArea::-webkit-scrollbar{
    display:none;
}

.quickBtn{
    flex:0 0 auto;
    padding:8px 12px;
    border-radius:20px;
    border:1px solid rgba(255,255,255,.07);
    background:#172640;
    color:#dce3ef;
    font-size:11px;
    cursor:pointer;
    transition:.2s;
}

.quickBtn:hover{
    background:#8b5cf6;
    color:#fff;
}

/* =====================================================
   INPUT
===================================================== */

.inputArea{
    display:flex;
    align-items:flex-end;
    gap:8px;
    padding:11px;
    background:#14233b;
    border-top:1px solid rgba(255,255,255,.07);
}

.messageInput{
    flex:1;
    min-height:44px;
    max-height:110px;
    resize:none;
    border:1px solid rgba(255,255,255,.07);
    outline:none;
    border-radius:13px;
    padding:12px;
    background:#081221;
    color:#fff;
    font-size:13px;
    line-height:1.4;
}

.messageInput:focus{
    border-color:rgba(139,92,246,.75);
}

.messageInput::placeholder{
    color:#657187;
}

.sendBtn{
    width:78px;
    height:44px;
    flex:0 0 78px;
    border:0;
    border-radius:13px;
    background:
        linear-gradient(
            135deg,
            #8b5cf6,
            #7042d7
        );
    color:#fff;
    font-weight:700;
    cursor:pointer;
    transition:.2s;
}

.sendBtn:hover{
    transform:translateY(-1px);
    box-shadow:
        0 7px 20px
        rgba(139,92,246,.25);
}

.sendBtn:disabled{
    opacity:.45;
    cursor:not-allowed;
    transform:none;
    box-shadow:none;
}

/* =====================================================
   LOADING
===================================================== */

.loading{
    margin:auto;
    display:flex;
    align-items:center;
    gap:5px;
    color:#77859a;
    font-size:12px;
}

.loadingDot{
    width:6px;
    height:6px;
    border-radius:50%;
    background:#8b5cf6;
    animation:pulse 1s infinite alternate;
}

.loadingDot:nth-child(2){
    animation-delay:.2s;
}

.loadingDot:nth-child(3){
    animation-delay:.4s;
}

@keyframes pulse{
    from{
        opacity:.25;
        transform:scale(.8);
    }

    to{
        opacity:1;
        transform:scale(1);
    }
}

/* =====================================================
   ERROR
===================================================== */

.errorBox{
    margin:auto;
    padding:24px;
    max-width:300px;
    text-align:center;
    color:#ff8f8f;
    font-size:12px;
    line-height:1.7;
}

.retryBtn{
    margin-top:12px;
    padding:9px 16px;
    border:0;
    border-radius:9px;
    background:#8b5cf6;
    color:#fff;
    cursor:pointer;
    font-weight:bold;
}

/* =====================================================
   MOBILE
===================================================== */

@media(max-width:500px){

    body{
        align-items:stretch;
    }

    .chatBox{
        width:100%;
        height:100vh;
        max-width:none;
        border-radius:0;
        border:0;
    }

    .connection{
        display:none;
    }

    .message{
        max-width:86%;
    }

}
</style>
</head>

<body>

<div class="chatBox">

    <!-- HEADER -->

    <div class="chatHeader">

        <button
            class="backBtn"
            onclick="goBack()"
            aria-label="Kembali"
        >
            ‹
        </button>

        <div class="avatarWrap">

            <div class="avatar">
                👩
            </div>

            <div class="avatarOnline"></div>

        </div>

        <div class="headerInfo">

            <div
                class="headerName"
                id="adminName"
            >
                Elsa
            </div>

            <div class="headerStatus">

                <span class="statusDot"></span>

                Admin Online

            </div>

        </div>

        <div
            class="connection"
            id="connectionStatus"
        >
            Menghubungkan...
        </div>

    </div>


    <!-- MESSAGES -->

    <div
        class="messages"
        id="messages"
    >

        <div class="loading">

            <span class="loadingDot"></span>
            <span class="loadingDot"></span>
            <span class="loadingDot"></span>

        </div>

    </div>


    <!-- QUICK BUTTONS -->

    <div class="quickArea">

        <button
            class="quickBtn"
            onclick="quickMessage('Halo admin, saya ingin cek proses deposit.')"
        >
            💰 Cek Deposit
        </button>

        <button
            class="quickBtn"
            onclick="quickMessage('Halo admin, saya ingin cek proses withdraw.')"
        >
            💸 Cek Withdraw
        </button>

        <button
            class="quickBtn"
            onclick="quickMessage('Halo admin, saya ingin bertanya.')"
        >
            ❓ Bantuan
        </button>

    </div>


    <!-- INPUT -->

    <div class="inputArea">

        <textarea
            id="messageInput"
            class="messageInput"
            placeholder="Ketik pesan..."
            maxlength="1000"
            disabled
        ></textarea>

        <button
            id="sendBtn"
            class="sendBtn"
            onclick="sendMessage()"
            disabled
        >
            Kirim
        </button>

    </div>

</div>


<script>

/* =====================================================
   API CONFIG
===================================================== */

/*
 * Jika livechat.html dan API berada
 * pada domain yang sama, biarkan kosong.
 *
 * Contoh:
 *
 * const API_BASE = "https://game-login-api.orkutstok64.workers.dev";
 *
 * Jika API berada di Worker lain:
 *
 * const API_BASE =
 *     "https://api.domainkamu.com";
 */

const API_BASE = "https://game-login-api.orkutstok64.workers.dev";


/* =====================================================
   ADMIN NAME
===================================================== */

const ADMIN_NAMES = [
    "Elsa",
    "Jeniffer",
    "Lisa",
    "Cila",
    "Caca"
];


function getAdminName(){

    const sixHours =
        6 * 60 * 60 * 1000;

    const startTime =
        new Date(
            "2026-01-01T00:00:00"
        ).getTime();

    const period =
        Math.floor(
            (
                Date.now() -
                startTime
            ) /
            sixHours
        );

    const index =
        (
            period %
            ADMIN_NAMES.length +
            ADMIN_NAMES.length
        )
        %
        ADMIN_NAMES.length;

    return ADMIN_NAMES[index];

}


function updateAdminName(){

    const element =
        document.getElementById(
            "adminName"
        );

    if(element){

        element.textContent =
            getAdminName();

    }

}


/* =====================================================
   STATE
===================================================== */

let chatMessages = [];

let loadingMessages = false;

let sendingMessage = false;

let firstLoad = true;

let lastMessageSignature = "";


/* =====================================================
   DOM
===================================================== */

const messagesElement =
    document.getElementById(
        "messages"
    );

const messageInput =
    document.getElementById(
        "messageInput"
    );

const sendButton =
    document.getElementById(
        "sendBtn"
    );


/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHTML(value){

    return String(
        value ?? ""
    )
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


/* =====================================================
   FORMAT TIME
===================================================== */

function formatTime(value){

    if(!value){

        return "";

    }

    const date =
        new Date(value);

    if(
        Number.isNaN(
            date.getTime()
        )
    ){

        return "";

    }

    return date.toLocaleTimeString(
        "id-ID",
        {
            hour:"2-digit",
            minute:"2-digit"
        }
    );

}


/* =====================================================
   MESSAGE TEXT
===================================================== */

function getMessageText(message){

    return String(
        message?.message ??
        message?.text ??
        ""
    );

}


/* =====================================================
   MESSAGE SENDER
===================================================== */

function getMessageSender(message){

    const sender =
        String(
            message?.sender ??
            message?.sender_type ??
            message?.type ??
            ""
        )
        .toLowerCase()
        .trim();


    if(
        sender === "admin" ||
        sender === "administrator"
    ){

        return "admin";

    }


    return "user";

}


/* =====================================================
   MESSAGE TIME
===================================================== */

function getMessageTime(message){

    return (
        message?.created_at ??
        message?.createdAt ??
        message?.time ??
        message?.timestamp ??
        ""
    );

}


/* =====================================================
   ENABLE CHAT
===================================================== */

function enableChat(){

    messageInput.disabled =
        false;

    sendButton.disabled =
        false;

}


/* =====================================================
   DISABLE CHAT
===================================================== */

function disableChat(){

    messageInput.disabled =
        true;

    sendButton.disabled =
        true;

}


/* =====================================================
   CONNECTION STATUS
===================================================== */

function setConnection(text){

    const element =
        document.getElementById(
            "connectionStatus"
        );

    if(element){

        element.textContent =
            text;

    }

}


/* =====================================================
   ERROR SCREEN
===================================================== */

function showError(message){

    messagesElement.innerHTML = `

        <div class="errorBox">

            ⚠️<br>

            ${message}

            <br>

            <button
                class="retryBtn"
                onclick="loadMessages(true)"
            >
                Coba Lagi
            </button>

        </div>

    `;

}


/* =====================================================
   SIGNATURE
===================================================== */

function createSignature(messages){

    try{

        return JSON.stringify(
            messages.map(
                message => ({
                    id:
                        message?.id ??
                        null,

                    message:
                        getMessageText(
                            message
                        ),

                    sender:
                        message?.sender ??
                        message?.sender_type ??
                        message?.type ??
                        "",

                    created_at:
                        getMessageTime(
                            message
                        )
                })
            )
        );

    }catch(error){

        return "";

    }

}


/* =====================================================
   GET MESSAGES FROM RESPONSE
===================================================== */

function extractMessages(data){

    if(
        data &&
        Array.isArray(
            data.messages
        )
    ){

        return data.messages;

    }


    if(
        data &&
        Array.isArray(
            data.data
        )
    ){

        return data.data;

    }


    if(
        data &&
        data.data &&
        Array.isArray(
            data.data.messages
        )
    ){

        return data.data.messages;

    }


    if(
        Array.isArray(data)
    ){

        return data;

    }


    return [];

}


/* =====================================================
   API REQUEST
===================================================== */

async function apiRequest(
    url,
    options={}
){

    const response =
        await fetch(
            API_BASE + url,
            {
                credentials:"include",
                cache:"no-store",
                ...options,
                headers:{
                    "Accept":
                        "application/json",
                    ...(options.headers || {})
                }
            }
        );


    let data = null;


    try{

        data =
            await response.json();

    }catch(error){

        data = null;

    }


    if(!response.ok){

        const error =
            new Error(
                data?.message ||
                data?.error ||
                `HTTP ${response.status}`
            );

        error.status =
            response.status;

        error.data =
            data;

        throw error;

    }


    return data;

}


/* =====================================================
   LOAD CHAT
===================================================== */

async function loadMessages(
    force=false
){

    if(loadingMessages){

        return;

    }


    loadingMessages = true;


    try{

        /*
         * Endpoint USER:
         *
         * GET /chat/messages
         *
         * Backend wajib mengambil
         * user berdasarkan session/login.
         */

        const data =
            await apiRequest(
                "/chat/messages"
            );


        const newMessages =
            extractMessages(
                data
            );


        chatMessages =
            newMessages;


        const signature =
            createSignature(
                chatMessages
            );


        const changed =
            signature !==
            lastMessageSignature;


        lastMessageSignature =
            signature;


        enableChat();

        setConnection(
            "Terhubung"
        );


        if(
            changed ||
            force ||
            firstLoad
        ){

            renderMessages();

        }


    }catch(error){

        console.error(
            "LOAD CHAT:",
            error
        );


        if(
            error.status === 401 ||
            error.status === 403
        ){

            setConnection(
                "Login diperlukan"
            );

            disableChat();


            showError(
                escapeHTML(
                    error.data?.message ||
                    "Session login tidak valid. Silakan login kembali."
                )
            );


            return;

        }


        setConnection(
            "Gagal terhubung"
        );


        /*
         * Hanya tampilkan error penuh
         * pada load pertama.
         *
         * Saat polling berikutnya gagal,
         * chat yang sudah ada tidak dihapus.
         */

        if(firstLoad){

            disableChat();

            showError(
                escapeHTML(
                    error.message ||
                    "Tidak dapat terhubung ke server chat."
                )
            );

        }

    }finally{

        firstLoad = false;

        loadingMessages = false;

    }

}


/* =====================================================
   SEND MESSAGE
===================================================== */

async function sendMessage(){

    if(
        sendingMessage ||
        messageInput.disabled
    ){

        return;

    }


    const text =
        messageInput.value.trim();


    if(!text){

        return;

    }


    if(text.length > 1000){

        alert(
            "Pesan maksimal 1000 karakter."
        );

        return;

    }


    sendingMessage =
        true;


    messageInput.disabled =
        true;

    sendButton.disabled =
        true;

    sendButton.textContent =
        "...";


    try{

        /*
         * Endpoint USER:
         *
         * POST /chat/send
         *
         * Tidak mengirim user_id.
         *
         * Backend harus menentukan
         * user berdasarkan session login.
         */

        await apiRequest(
            "/chat/send",
            {
                method:"POST",

                headers:{
                    "Content-Type":
                        "application/json"
                },

                body:
                    JSON.stringify({
                        message:text
                    })
            }
        );


        messageInput.value =
            "";

        messageInput.style.height =
            "44px";


        /*
         * Ambil ulang dari database.
         */

        await loadMessages(
            true
        );


    }catch(error){

        console.error(
            "SEND CHAT:",
            error
        );


        if(
            error.status === 401 ||
            error.status === 403
        ){

            disableChat();

            alert(
                error.data?.message ||
                "Session login sudah tidak valid."
            );

        }else{

            alert(
                error.message ||
                "Pesan gagal dikirim."
            );

        }

    }finally{

        sendingMessage =
            false;

        /*
         * Jangan mengaktifkan kembali
         * jika session sudah invalid.
         */

        if(
            !(
                messageInput.disabled &&
                sendButton.disabled &&
                document
                    .getElementById(
                        "connectionStatus"
                    )
                    ?.textContent
                    ===
                    "Login diperlukan"
            )
        ){

            messageInput.disabled =
                false;

            sendButton.disabled =
                false;

        }


        sendButton.textContent =
            "Kirim";

    }

}


/* =====================================================
   RENDER MESSAGES
===================================================== */

function renderMessages(){

    if(
        !Array.isArray(
            chatMessages
        ) ||
        chatMessages.length === 0
    ){

        messagesElement.innerHTML = `

            <div class="empty">

                <div class="emptyIcon">
                    💬
                </div>

                Belum ada percakapan.<br>

                Silakan kirim pesan kepada admin.

            </div>

        `;

        return;

    }


    const wasNearBottom =
        (
            messagesElement.scrollTop +
            messagesElement.clientHeight
        )
        >=
        (
            messagesElement.scrollHeight -
            120
        );


    let html = "";


    chatMessages.forEach(
        message => {

            const sender =
                getMessageSender(
                    message
                );


            const text =
                getMessageText(
                    message
                );


            const time =
                formatTime(
                    getMessageTime(
                        message
                    )
                );


            const adminName =
                message?.admin_name ??
                message?.adminName ??
                getAdminName();


            html += `

                <div
                    class="message ${sender}"
                >

                    ${escapeHTML(text)}

                    <span
                        class="messageTime"
                    >

                        ${
                            sender === "admin"
                            ?
                            escapeHTML(
                                adminName
                            )
                            :
                            "Anda"
                        }

                        ${
                            time
                            ?
                            " • " +
                            escapeHTML(time)
                            :
                            ""
                        }

                    </span>

                </div>

            `;

        }
    );


    messagesElement.innerHTML =
        html;


    if(
        wasNearBottom ||
        chatMessages.length === 1
    ){

        messagesElement.scrollTop =
            messagesElement.scrollHeight;

    }

}


/* =====================================================
   QUICK MESSAGE
===================================================== */

function quickMessage(text){

    if(
        messageInput.disabled
    ){

        return;

    }


    messageInput.value =
        text;


    messageInput.style.height =
        "auto";


    messageInput.style.height =
        Math.min(
            messageInput.scrollHeight,
            110
        ) + "px";


    sendMessage();

}


/* =====================================================
   ENTER TO SEND
===================================================== */

messageInput.addEventListener(
    "keydown",
    function(event){

        if(
            event.key === "Enter" &&
            !event.shiftKey
        ){

            event.preventDefault();

            sendMessage();

        }

    }
);


/* =====================================================
   TEXTAREA RESIZE
===================================================== */

messageInput.addEventListener(
    "input",
    function(){

        this.style.height =
            "auto";

        this.style.height =
            Math.min(
                this.scrollHeight,
                110
            ) + "px";

    }
);


/* =====================================================
   BACK
===================================================== */

function goBack(){

    if(
        window.history.length > 1
    ){

        window.history.back();

    }else{

        window.location.href =
            "/";

    }

}


/* =====================================================
   REALTIME
===================================================== */

/*
 * Mengecek database setiap 2 detik.
 *
 * Jika tidak ada perubahan,
 * tampilan tidak dirender ulang.
 */

setInterval(
    function(){

        loadMessages();

    },
    2000
);


/* =====================================================
   ADMIN NAME
===================================================== */

